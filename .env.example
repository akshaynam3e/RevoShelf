# ---------- API (apps/api) : set in Render "Environment" for the web service ----------
NODE_ENV=development
PORT=4000
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SECRET. Server only. Never put this in the web app or commit it.
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma separated list of allowed browser origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173

# ---------- Web (apps/web) : VITE_* values are PUBLIC and baked into the bundle ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key only. NEVER the service role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_FIREBASE_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}
